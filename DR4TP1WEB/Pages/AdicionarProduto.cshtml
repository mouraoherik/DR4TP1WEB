@page
@model DR4TP1WEB.Pages.AdicionarProduto

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Adicionar Produto</title>
</head>
<body>



<form method="post">
    <fieldset>
        <legend>Add Customer</legend>
        <div>
            <label asp-for="Nome" class="form-label">Nome do Produto</label>
            <input asp-for="Nome" class="form-control"/>
        </div>
        <div>
            <label asp-for="Preco" class="form-label">Preco do Produto</label>
            <input asp-for="Preco" class="form-control" type="number" step="0.01"/>
        </div>
        <button type="submit" class="btn btn-primary">Salvar</button>
    </fieldset>
</form>
</body>
</html>

@if (Model.Enviado)
{
    <hr />
    <h2>Dados recebidos</h2>
    <p><strong>Nome:</strong> @Model.Nome</p>
    <p><strong>Preço:</strong> @Model.Preco?.ToString("C")</p>
}